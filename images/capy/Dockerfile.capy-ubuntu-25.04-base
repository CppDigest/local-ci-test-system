# Ubuntu 25.04 (Oracular Oriole) reached end-of-life 2026-01-15 and is no longer
# receiving security updates. Kept for CI parity with capy workflow matrix
# (container: ubuntu:25.04). Plan: migrate to ubuntu:24.04 LTS or ubuntu:26.04
# when capy CI and image names are updated; target Q2 2026.
FROM ubuntu:25.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ca-certificates \
    curl \
    wget \
    gnupg \
    lsb-release \
    software-properties-common \
    cmake \
    ninja-build \
    ccache \
    pkg-config \
    python3 \
    python3-pip \
    nodejs \
    npm \
    libssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && found=0 \
    && for pkg in \
        b2 \
        boost-build \
        libboost-tools-dev \
        libboost1.86-tools-dev \
        libboost1.85-tools-dev \
        libboost1.83-tools-dev \
        libboost1.74-tools-dev; do \
        if apt-get install -y --no-install-recommends "${pkg}"; then \
          found=1; \
          break; \
        fi; \
      done \
    && test "${found}" = "1" \
    && if ! command -v b2 >/dev/null 2>&1 && command -v bjam >/dev/null 2>&1; then \
        ln -sf "$(command -v bjam)" /usr/local/bin/b2; \
      fi \
    && command -v b2 >/dev/null 2>&1 \
    && rm -rf /var/lib/apt/lists/*

# Keep a shallow Boost superproject clone for workflow reuse.
RUN git clone --depth=1 --branch=develop https://github.com/boostorg/boost.git /opt/boost-source

RUN mkdir -p /cache/ccache

ENV CCACHE_DIR=/cache/ccache
ENV CCACHE_MAXSIZE=2G
ENV BOOST_ROOT=/opt/boost-source

WORKDIR /workspace

LABEL org.localci.project="capy"
LABEL org.localci.image.kind="base"
LABEL org.localci.os="ubuntu:25.04"
