FROM capy-ubuntu-24.04-clang20:latest

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-multilib \
        g++-multilib \
        libc6-dev-i386 \
        lib32stdc++-13-dev \
    && rm -rf /var/lib/apt/lists/*

ENV CFLAGS=-m32
ENV CXXFLAGS=-m32

LABEL org.localci.image.kind="project"
LABEL org.localci.compiler="clang-20"
LABEL org.localci.architecture="x86"
